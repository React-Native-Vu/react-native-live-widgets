{
  "name": "react-native-live-widgets",
  "version": "1.1.0",
  "description": "All-in-One Live Activities (iOS 16.1+ WidgetKit / Dynamic Island), Live Updates (Android 16+ ProgressStyle) and Interactive Multi-Page Home Screen Widgets for React Native & Expo with Declarative Dynamic UI Engine",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "app": "./app.plugin.js",
  "plugin": "./app.plugin.js",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "ios",
    "android/src",
    "android/build.gradle",
    "app.plugin.js",
    "cli",
    "docs",
    "assets",
    "react-native-live-widgets.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "react-native-live-widgets": "cli/setup.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/build.js",
    "version:patch": "node scripts/release.js patch",
    "version:minor": "node scripts/release.js minor",
    "version:major": "node scripts/release.js major",
    "release:patch": "node scripts/release.js patch --tag",
    "release:minor": "node scripts/release.js minor --tag",
    "release:major": "node scripts/release.js major --tag"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/React-Native-Vu/react-native-live-widgets.git"
  },
  "keywords": [
    "react-native",
    "live-activity",
    "dynamic-island",
    "widgetkit",
    "home-screen-widgets",
    "interactive-widgets",
    "android-live-update",
    "progress-style",
    "shared-storage",
    "app-groups",
    "expo",
    "expo-plugin",
    "config-plugin"
  ],
  "author": "vu-tran",
  "license": "MIT",
  "dependencies": {
    "xcode": "^3.0.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "@expo/config-plugins": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
